    "an-array-of-spanish-words": "2.0.0",
    "most-common-words-by-language": "3.0.14",
    "gsap": "3.15.1",
    "matter-js": "0.20.0",
    "planck": "1.5.1",
    "pixi.js": "8.22.0",
    "howler": "2.2.4",
    "zzfx": "1.4.0",
    "simplex-noise": "4.0.3",
    "canvas-confetti": "1.9.4",
